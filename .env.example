# Environnement global de reference pour Smart Traffic Platform.
# Copier les valeurs utiles dans les .env locaux; ne jamais commiter de vrais secrets.

# Environnement Node commun aux services.
NODE_ENV=development

# Port public du frontend Next.js.
FRONTEND_PORT=3000

# Port public de l'API Gateway GraphQL.
API_GATEWAY_PORT=4000

# Port public PostgreSQL pour un lancement local.
POSTGRES_PORT=5432

# Nom de la base PostgreSQL de developpement.
POSTGRES_DB=smart_traffic_example

# Utilisateur PostgreSQL de developpement.
POSTGRES_USER=smart_traffic_example

# Mot de passe PostgreSQL factice pour l'exemple uniquement.
POSTGRES_PASSWORD=replace-with-local-password

# URL PostgreSQL utilisee par Prisma en execution locale hors Docker.
DATABASE_URL=postgresql://smart_traffic_example:replace-with-local-password@localhost:5432/smart_traffic_example?schema=public

# Secret JWT factice partage entre Auth Service et les services metier en local.
JWT_SECRET=replace-with-access-token-secret

# Secret factice dedie aux refresh tokens de l'Auth Service.
JWT_REFRESH_SECRET=replace-with-refresh-token-secret

# Duree de validite des access tokens.
JWT_EXPIRES_IN=15m

# Duree de validite des refresh tokens.
JWT_REFRESH_EXPIRES_IN=7d

# Origines autorisees pour CORS, separees par des virgules.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# URL publique GraphQL consommee par le navigateur.
NEXT_PUBLIC_GRAPHQL_GATEWAY_URL=http://localhost:4000/graphql

# URL GraphQL cote serveur Next.js.
GRAPHQL_GATEWAY_URL=http://localhost:4000/graphql

# URL publique du WebSocket de notifications.
NEXT_PUBLIC_NOTIFICATION_WS_URL=http://localhost:3005/notifications
