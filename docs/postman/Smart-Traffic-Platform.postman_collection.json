{
  "info": {
    "_postman_id": "e34f7f22-0f6e-4ef7-9db7-smarttrafficapi",
    "name": "Smart Traffic Platform - API Gateway GraphQL",
    "description": "Collection Postman pour tester Smart Traffic Platform via l'API Gateway GraphQL uniquement: {{gatewayUrl}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Register($input: RegisterInput!) {\n  register(input: $input) {\n    accessToken\n    refreshToken\n    user {\n      id\n      email\n      firstName\n      lastName\n      role\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"operator@example.com\",\n    \"password\": \"Password123!\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"Operator\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.login?.accessToken;",
                  "pm.test('login returns accessToken', function () {",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "});",
                  "if (token) {",
                  "  pm.environment.set('accessToken', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation Login($input: LoginInput!) {\n  login(input: $input) {\n    accessToken\n    refreshToken\n    user {\n      id\n      email\n      firstName\n      lastName\n      role\n    }\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"email\": \"operator@example.com\",\n    \"password\": \"Password123!\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "me",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query Me {\n  me {\n    id\n    email\n    firstName\n    lastName\n    role\n    createdAt\n    updatedAt\n  }\n}",
                "variables": "{}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Vehicle",
      "item": [
        {
          "name": "createVehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?.createVehicle?.id;",
                  "if (id) {",
                  "  pm.environment.set('vehicleId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
