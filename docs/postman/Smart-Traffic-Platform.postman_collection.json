                "variables": "{\n  \"input\": {\n    \"name\": \"Centre-ville Tunis\",\n    \"description\": \"Zone de surveillance du trafic au centre-ville.\",\n    \"latitude\": 36.8065,\n    \"longitude\": 10.1815,\n    \"radius\": 1200,\n    \"vehicleCount\": 25\n  }\n}"
