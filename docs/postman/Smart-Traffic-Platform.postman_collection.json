            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateVehicle($input: CreateVehicleInput!) {\n  createVehicle(input: $input) {\n    id\n    matricule\n    brand\n    model\n    type\n    status\n    createdAt\n    updatedAt\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"matricule\": \"TN-2026-001\",\n    \"brand\": \"Renault\",\n    \"model\": \"Clio\",\n    \"type\": \"CAR\",\n    \"status\": \"ACTIVE\"\n  }\n}"
              }
            }
          }
        },
        {
          "name": "simulateVehiclePosition",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}",
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation SimulateVehiclePosition($vehicleId: ID!) {\n  simulateVehiclePosition(vehicleId: $vehicleId) {\n    id\n    vehicleId\n    latitude\n    longitude\n    speed\n    recordedAt\n  }\n}",
                "variables": "{\n  \"vehicleId\": \"{{vehicleId}}\"\n}"
              }
            }
          }
        }
      ]
    },
