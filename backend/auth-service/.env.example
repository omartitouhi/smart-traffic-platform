# Environnement d'execution du service.
NODE_ENV=development

# Port HTTP interne du service Auth.
PORT=3000

# URL PostgreSQL utilisee par Prisma.
DATABASE_URL=postgresql://smart_traffic_example:replace-with-local-password@localhost:5432/smart_traffic_example?schema=public

# Secret factice pour signer les access tokens JWT.
JWT_SECRET=replace-with-access-token-secret

# Secret factice pour signer les refresh tokens.
JWT_REFRESH_SECRET=replace-with-refresh-token-secret

# Duree de validite des access tokens.
JWT_EXPIRES_IN=15m

# Duree de validite des refresh tokens.
JWT_REFRESH_EXPIRES_IN=7d

# Origines autorisees pour les appels HTTP GraphQL.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# Active Playground/Apollo Sandbox en local; mettre false ou omettre en production.
GRAPHQL_UI_ENABLED=true
