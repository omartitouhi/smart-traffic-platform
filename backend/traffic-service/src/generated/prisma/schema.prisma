// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CongestionLevel {
  LOW
  MEDIUM
  HIGH
}

model TrafficZone {
  id              String          @id @default(uuid()) @db.Uuid
  name            String          @unique @db.VarChar(120)
  description     String?         @db.Text
  latitude        Decimal         @db.Decimal(9, 6)
  longitude       Decimal         @db.Decimal(9, 6)
  radius          Decimal         @db.Decimal(10, 2)
  vehicleCount    Int             @default(0) @map("vehicle_count")
  density         Decimal         @default(0) @db.Decimal(10, 2)
  congestionLevel CongestionLevel @default(LOW) @map("congestion_level")
  isCongested     Boolean         @default(false) @map("is_congested")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([congestionLevel])
  @@index([isCongested])
  @@map("traffic_zones")
}
